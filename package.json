{
  "name": "jeevansetu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm --filter @jeevansetu/api dev\" \"pnpm --filter @jeevansetu/web dev\"",
    "build": "pnpm --filter @jeevansetu/api build && pnpm --filter @jeevansetu/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:reset": "pnpm --filter @jeevansetu/api db:reset",
    "build:web": "pnpm --filter @jeevansetu/web build",
    "build:fn": "node scripts/build-fn.mjs",
    "vercel-build": "pnpm --filter @jeevansetu/web build && pnpm build:fn"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.2",
    "@vercel/functions": "^3.9.5",
    "hono": "^4.6.14",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.9",
    "pdfkit": "^0.15.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
