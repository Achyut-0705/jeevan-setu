{
  "//": "Root config, used only for the Vercel Function entrypoint in api/. Each workspace package has its own tsconfig.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["api/**/*.ts", "apps/api/src/**/*.ts", "packages/shared/src/**/*.ts"],
  "exclude": ["node_modules", "**/dist"]
}
