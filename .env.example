# Every variable here has a working default (see apps/api/src/env.ts) — copy this to
# .env only when you want to override something.

PORT=8787

# Replace both before any deployment that is not a throwaway demo.
JWT_SECRET=dev-jwt-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Gates /api/dev/* — the operator console where a verification officer signs off a
# call or decides a review request. Leave true for demos: with it off, no call can be
# completed and therefore no full certificate can be issued.
ENABLE_DEV_TOOLS=true

# sqlite = a file on disk (local dev). memory = per-process, reseeded on boot; this is
# forced on Vercel, where the filesystem is read-only and native modules cannot load.
PERSIST=sqlite
DATA_DIR=./data

# Used to build certificate verification links and family attestation SMS links.
# Derived from VERCEL_URL when unset on Vercel; set it explicitly once a custom
# domain is attached, or printed QR codes will point at the deployment URL.
PUBLIC_BASE_URL=http://localhost:5173

# server = the API runs the face pipeline. client = the browser extracts the
# descriptor and the server still does the comparison and all scoring. Forced to
# client on Vercel, where TensorFlow is far too large for a function bundle.
FACE_ENGINE=server

# real = run the face pipeline. simulate = short-circuit it, so a camera or hardware
# failure on stage cannot block a walkthrough.
VERIFICATION_MODE=real
